<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="dev.infend.skyrimtext.permission.LOCAL_ENGINE" />
    <queries><package android:name="dev.infend.skyrimtext" /></queries>
    <application android:label="SKYRIM Local AI Engine" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".EngineActivationActivity" android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".EngineDiagnosticsProvider"
            android:authorities="dev.infend.skyrimtext.engine.diagnostics"
            android:exported="true" android:permission="dev.infend.skyrimtext.permission.LOCAL_ENGINE" />
        <service android:name="dev.infend.skyrimtext.LocalAiInferenceService" android:exported="true"
            android:permission="dev.infend.skyrimtext.permission.LOCAL_ENGINE" android:process=":llm" />
    </application>
</manifest>
