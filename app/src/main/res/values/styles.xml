<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">serif</item>
        <item name="android:colorAccent">#E1C58F</item>
        <item name="android:alertDialogTheme">@style/RunicDialogTheme</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#070B0F</item>
        <item name="android:navigationBarColor">#070B0F</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#070B0F</item>
    </style>
    <style name="RunicDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_panel</item>
        <item name="android:colorAccent">#E1C58F</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColorPrimary">#EDE7DA</item>
        <item name="android:textColorSecondary">#A9AAA5</item>
        <item name="android:colorControlActivated">#E1C58F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
